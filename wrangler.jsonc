{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levitateweb",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/mi-levitate-demo/*",
      "/votacion-releve",
      "/votacion-releve/",
      "/jueceo",
      "/jueceo/",
      "/jueceo/admin",
      "/jueceo/admin/",
      "/jueceo/releve",
      "/jueceo/releve/",
      "/jueceo/app",
      "/jueceo/app/",
      "/jueceo/app/index.html"
    ],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "TICKET_SALES_PAUSED": "false",
    "REGISTRATION_PAUSED_VENUES": "edomex",
    "PARTICIPANT_REGISTRATION_EVENT_IDS": "edomex-2026-otono",
    "PARTICIPANT_MEDIA_DRIVE_ACCOUNT_EMAIL": "musica.levitate@gmail.com",
    "JUDGING_SUPABASE_URL": "https://twazfaytgmgeyqeopgut.supabase.co",
    "JUDGING_SELECTABLE_JUDGE_USER_IDS": "ad8fa4eb-3095-4b73-a34f-b8b596f588bf",
    "JUDGING_LEVITATE_EVENT_IDS": "0bea286d-31ad-462c-968a-2744c57ea9c3,25cf168b-4bf1-423f-b2c2-42897d3f8110,ef1dc272-99d5-425e-b930-6f3959b7c8b2,a62f724b-9d66-47ea-8dee-d54294783130"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "levitate-passport",
      "database_id": "d4a3a9e7-70e6-4a8c-8514-5c9136b924a2"
    }
  ],
  "migrations": [
    {
      "tag": "v1_media_overrides_store",
      "new_sqlite_classes": [
        "MediaOverridesStore"
      ]
    },
    {
      "tag": "v2_delete_media_overrides_store",
      "deleted_classes": [
        "MediaOverridesStore"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
