+  test(
+      'switching a website judge selects an assigned block and preserves the original outbox',
+      () async {
+    SharedPreferences.setMockInitialValues({
+      'selectedJudge': 'DANIEL.H',
+      'selectedBlockId': 'block-1',
+    });
+    final data = jsonDecode(jsonEncode(encodeAppData(program())))
+        as Map<String, dynamic>;
+    (data['judgeProfiles'] as List)[0]['assigned_block_ids'] = ['block-1'];
+    (data['judgeProfiles'] as List)[1]
+        ['assigned_block_ids'] = ['block-2', 'block-3'];
+    (data['routines'] as List).addAll([
+      {
+        'routine_id': '134',
+        'name': 'Motion',
+        'block_id': 'block-2',
+        'block': 'Block 2',
+        'genre': 'TEST'
+      },
+      {
+        'routine_id': '135',
+        'name': 'Motion 2',
+        'block_id': 'block-3',
+        'block': 'Block 3',
+        'genre': 'TEST'
+      },
+    ]);
+    (data['blocks'] as List).addAll([
+      {'block_id': 'block-2', 'name': 'Block 2'},
+      {'block_id': 'block-3', 'name': 'Block 3'},
+    ]);
+    final api = FakeJudgingApi()..programData = AppData.fromJson(data);
+    final repository = MemoryJudgingRepository();
+    final store = JudgingStore(api,
+        automaticSync: false,
+        restrictedJudgeSession: true,
+        localRepository: repository);
+    await store.initialize();
+    final original = store.routines.first;
+    await store.submitScores(original, {1: 8});
+    expect(store.pendingCount, 1);
+    await store
+        .saveDraft(store.currentScope, original.id, 'DANIEL.H', {'1': 9});
+    store.selectJudge('LUIS');
+    expect(store.blocks.map((block) => block.blockId), ['block-2', 'block-3']);
+    expect(store.selectedBlockId, 'block-2');
+    expect(store.selectedRoutine?.id, '134');
+    expect(store.visibleRoutines.map((routine) => routine.id), ['134']);
+    store.selectBlock(store.appData!.blocks.first);
+    store.selectRoutine(original.id);
+    expect(store.selectedBlockId, 'block-2');
+    expect(store.selectedRoutine?.id, '134');
+    await expectLater(store.submitScores(original, {1: 5}), throwsStateError);
+    expect(store.pendingCount, 1);
+    store.selectBlock(store.blocks.last);
+    store.selectJudge('LUIS');
+    expect(store.selectedBlockId, 'block-3',
+        reason: 'Keep a block that is still assigned');
+    store.selectJudge('DANIEL.H');
+    expect(store.selectedBlockId, 'block-1');
+    expect(store.selectedRoutine?.id, original.id);
+    expect(store.scores.values, contains(8));
+    expect(store.draftFor(original, 'DANIEL.H'), {'1': 9});
+    store.selectJudge('LUIS');
+    await store.syncPending();
+    expect(store.pendingCount, 0);
+    expect(api.scoreRows.single['judge_id'], 'daniel');
+    expect(api.scoreRows.single['routine_id'], original.id);
+    expect(api.scoreRows.single['value'], 8);
+    await store.close();
+
+    // Assignments survive an offline restore, independently of preferences.
+    final offline = FakeJudgingApi()..offline = true;
+    final restored = JudgingStore(offline,
+        automaticSync: false,
+        restrictedJudgeSession: true,
+        localRepository: repository);
+    await restored.initialize();
+    restored.selectJudge('LUIS');
+    expect(
+        restored.blocks.map((block) => block.blockId), ['block-2', 'block-3']);
+    expect(restored.selectedRoutine?.blockId, 'block-2');
+    restored.selectJudge('DANIEL.H');
+    expect(restored.draftFor(restored.routines.first, 'DANIEL.H'), {'1': 9});
+    await restored.close();
+  });
