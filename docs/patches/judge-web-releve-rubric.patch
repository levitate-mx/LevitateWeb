diff --git a/test/releve_rubric_test.dart b/test/releve_rubric_test.dart
new file mode 100644
index 0000000..ccbbd02
--- /dev/null
+++ b/test/releve_rubric_test.dart
@@ -0,0 +1,150 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jueceo_coreografias_tablet/judging_store.dart';
+import 'package:jueceo_coreografias_tablet/local_judging_codec.dart';
+import 'package:jueceo_coreografias_tablet/models.dart';
+import 'package:jueceo_coreografias_tablet/main.dart';
+import 'package:jueceo_coreografias_tablet/levitate_web_theme.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'support/judging_fixture.dart';
+import 'support/memory_judging_repository.dart';
+
+const labels = [
+  'Técnica y control',
+  'Composición coreográfica',
+  'Musicalidad',
+  'Interpretación artística',
+  'Presencia escénica'
+];
+AppData releveProgram() {
+  final data = encodeAppData(program());
+  data['routines'] = [
+    {
+      'routine_id': '232',
+      'name': 'Relevé',
+      'division': 'RELEVÉ',
+      'genre': 'TELA',
+      'block_id': 'block-1',
+      'block': 'Block 1'
+    },
+    {
+      'routine_id': 'ordinary',
+      'name': 'Aerial Senior',
+      'division': 'SENIOR',
+      'genre': 'TELA',
+      'block_id': 'block-1',
+      'block': 'Block 1'
+    },
+  ];
+  data['templates'] = [
+    {
+      'template_id': 'tela',
+      'genre': 'TELA',
+      'title': 'TELA',
+      'max_score': 70,
+      'applies_to': {
+        'primary_categories': ['TELA']
+      },
+      'criteria': List.generate(
+          15,
+          (index) => {
+                'id': index + 1,
+                'label': 'Criterio de tela ${index + 1}',
+                'section': 'Técnica',
+                'max_score': index < 10 ? 5 : 4
+              })
+    },
+    {
+      'template_id': 'releve',
+      'genre': 'RELEVÉ',
+      'title': 'HOJA DE JUECEO RELEVÉ',
+      'max_score': 15,
+      'applies_to': {
+        'divisions': ['RELEVÉ'],
+        'primary_categories': ['TELA', 'ARO', 'TRAPECIO']
+      },
+      'criteria': List.generate(
+          5,
+          (index) => {
+                'id': index + 1,
+                'label': labels[index],
+                'section': 'RELEVÉ',
+                'max_score': 3
+              })
+    },
+  ];
+  return AppData.fromJson(data);
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test(
+      'the remote bundle and offline codec retain division-specific Relevé rubric selection',
+      () async {
+    final input = releveProgram();
+    final raw = encodeAppData(input);
+    final templateRows =
+        (raw['templates'] as List).cast<Map<String, dynamic>>();
+    final api = FakeJudgingApi();
+    final bundle = api.bundleFromRows(event('event-a'),
+        blockRows: raw['blocks'] as List,
+        routineRows: raw['routines'] as List,
+        judgeRows: raw['judgeProfiles'] as List,
+        templateRows: templateRows,
+        criterionRows: [
+          for (final template in templateRows)
+            for (final criterion in template['criteria'] as List)
+              {
+                ...criterion as Map<String, dynamic>,
+                'template_id': template['template_id']
+              }
+        ],
+        scoreRows: [],
+        feedbackRows: [],
+        penaltyRows: [],
+        favoriteRows: []);
+    final restored = AppData.fromJson(encodeAppData(bundle.appData));
+    final store = JudgingStore(api,
+        automaticSync: false, localRepository: MemoryJudgingRepository())
+      ..appData = restored;
+    final releve = store.templateFor(restored.routines.first);
+    expect(releve.templateId, 'releve');
+    expect(releve.maxScore, 15);
+    expect(releve.criteria.map((criterion) => criterion.label), labels);
+    expect(
+        releve.criteria.every((criterion) => criterion.maxScore == 3), isTrue);
+    expect(store.templateFor(restored.routines.last).templateId, 'tela');
+    expect(store.templateFor(restored.routines.last).criteria.length, 15);
+    await store.close();
+  });
+
+  testWidgets(
+      'the Relevé sheet shows only five rubric labels and each score range is 1 to 3',
+      (tester) async {
+    SharedPreferences.setMockInitialValues(
+        {'selectedJudge': 'DANIEL.H', 'selectedRoutineId': '232'});
+    final api = FakeJudgingApi()..programData = releveProgram();
+    final store = JudgingStore(api,
+        automaticSync: false, localRepository: MemoryJudgingRepository());
+    store.appData = releveProgram();
+    store.selectedEvent = event('event-a');
+    store.selectedJudge = 'DANIEL.H';
+    store.selectedRoutineId = '232';
+    store.selectedBlockId = 'block-1';
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(1280, 720);
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    await tester.pumpWidget(MaterialApp(
+        theme: levitateWebTheme(Brightness.dark),
+        home: Scaffold(body: JudgingPage(store: store))));
+    await tester.pump();
+    expect(find.byType(ScoreStepperField), findsNWidgets(5));
+    for (final label in labels) expect(find.text(label), findsOneWidget);
+    expect(find.text('1 a 3 puntos'), findsNWidgets(5));
+    expect(find.textContaining('Criterio de tela'), findsNothing);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox());
+    await store.close();
+  });
+}
