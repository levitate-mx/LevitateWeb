@@ -0,0 +1,73 @@
+import 'dart:js_interop';
+
+import 'package:flutter/material.dart';
+import 'package:web/web.dart' as web;
+
+class FullscreenButton extends StatefulWidget {
+  const FullscreenButton({super.key});
+
+  @override
+  State<FullscreenButton> createState() => _FullscreenButtonState();
+}
+
+class _FullscreenButtonState extends State<FullscreenButton> {
+  late final JSFunction _onFullscreenChange;
+  bool _fullscreen = web.document.fullscreenElement != null;
+  bool _busy = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _onFullscreenChange = ((web.Event event) {
+      if (mounted) {
+        setState(() => _fullscreen = web.document.fullscreenElement != null);
+      }
+    }).toJS;
+    web.document.addEventListener('fullscreenchange', _onFullscreenChange);
+  }
+
+  @override
+  void dispose() {
+    web.document.removeEventListener('fullscreenchange', _onFullscreenChange);
+    super.dispose();
+  }
+
+  Future<void> _toggle() async {
+    if (_busy) return;
+    setState(() => _busy = true);
+    try {
+      // Request immediately inside the click: browsers require user activation.
+      if (web.document.fullscreenElement != null) {
+        await web.document.exitFullscreen().toDart;
+      } else {
+        await web.document.documentElement!.requestFullscreen().toDart;
+      }
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.maybeOf(context)?.showSnackBar(const SnackBar(
+            content:
+                Text('El navegador no permitió cambiar a pantalla completa.')));
+      }
+    } finally {
+      if (mounted) {
+        setState(() {
+          _busy = false;
+          _fullscreen = web.document.fullscreenElement != null;
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!web.document.fullscreenEnabled && !_fullscreen) {
+      return const SizedBox.shrink();
+    }
+    return IconButton(
+      tooltip: _fullscreen ? 'Salir de pantalla completa' : 'Pantalla completa',
+      onPressed: _busy ? null : _toggle,
+      icon: Icon(_fullscreen ? Icons.fullscreen_exit : Icons.fullscreen),
+      constraints: const BoxConstraints(minWidth: 48, minHeight: 48),
+    );
+  }
+}
