{
  "name": "levitate-mx-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "db:migrate:codi": "node scripts/migrate-codi-db.mjs",
    "db:migrate:passport": "wrangler d1 execute levitate-passport --remote --file db/passport_d1_schema.sql",
    "db:migrate:passport:local": "wrangler d1 execute levitate-passport --local --file db/passport_d1_schema.sql",
    "db:migrate:registration": "wrangler d1 execute levitate-passport --remote --file db/registration_d1_schema.sql",
    "db:migrate:registration:local": "wrangler d1 execute levitate-passport --local --file db/registration_d1_schema.sql",
    "db:migrate:registration:buyer-phone": "wrangler d1 execute levitate-passport --remote --file db/registration_order_buyer_phone.sql",
    "db:migrate:registration:buyer-phone:local": "wrangler d1 execute levitate-passport --local --file db/registration_order_buyer_phone.sql",
    "db:migrate:registration:choreographer-shirt-size": "wrangler d1 execute levitate-passport --remote --file db/registration_choreographer_shirt_size.sql",
    "db:migrate:registration:choreographer-shirt-size:local": "wrangler d1 execute levitate-passport --local --file db/registration_choreographer_shirt_size.sql",
    "db:migrate:registration:participant-releve-teacher": "wrangler d1 execute levitate-passport --remote --file db/registration_participant_releve_teacher.sql",
    "db:migrate:registration:participant-releve-teacher:local": "wrangler d1 execute levitate-passport --local --file db/registration_participant_releve_teacher.sql",
    "db:migrate:registration:participant-international": "wrangler d1 execute levitate-passport --remote --file db/registration_participant_international.sql",
    "db:migrate:registration:participant-international:local": "wrangler d1 execute levitate-passport --local --file db/registration_participant_international.sql",
    "db:migrate:registration:payment-review": "wrangler d1 execute levitate-passport --remote --file db/registration_order_payment_review.sql",
    "db:migrate:registration:payment-review:local": "wrangler d1 execute levitate-passport --local --file db/registration_order_payment_review.sql",
    "db:migrate:registration:tickets": "wrangler d1 execute levitate-passport --remote --file db/registration_event_tickets.sql",
    "db:migrate:registration:tickets:local": "wrangler d1 execute levitate-passport --local --file db/registration_event_tickets.sql",
    "db:migrate:registration:auth": "wrangler d1 execute levitate-passport --remote --file db/registration_auth_tokens.sql",
    "db:migrate:registration:auth:local": "wrangler d1 execute levitate-passport --local --file db/registration_auth_tokens.sql",
    "db:migrate:registration:aerial-open-subgenres": "wrangler d1 execute levitate-passport --remote --file db/registration_aerial_open_subgenres.sql",
    "db:migrate:registration:aerial-open-subgenres:local": "wrangler d1 execute levitate-passport --local --file db/registration_aerial_open_subgenres.sql",
    "db:migrate:registration:recognition-documents": "wrangler d1 execute levitate-passport --remote --file db/registration_recognition_documents.sql",
    "db:migrate:registration:recognition-documents:local": "wrangler d1 execute levitate-passport --local --file db/registration_recognition_documents.sql",
    "db:migrate:registration:music-uploads": "wrangler d1 execute levitate-passport --remote --file db/registration_music_uploads.sql",
    "db:migrate:registration:music-uploads:local": "wrangler d1 execute levitate-passport --local --file db/registration_music_uploads.sql",
    "db:migrate:registration:program-divisions": "wrangler d1 execute levitate-passport --remote --file db/registration_program_divisions.sql",
    "db:migrate:registration:program-divisions:local": "wrangler d1 execute levitate-passport --local --file db/registration_program_divisions.sql",
    "db:migrate:registration:shop-orders": "wrangler d1 execute levitate-passport --remote --file db/registration_shop_orders.sql",
    "db:migrate:registration:shop-orders:local": "wrangler d1 execute levitate-passport --local --file db/registration_shop_orders.sql",
    "db:migrate": "npm run db:migrate:codi",
    "db:migrate:all": "npm run db:migrate:codi && npm run db:migrate:passport && npm run db:migrate:registration",
    "passport:generate": "node scripts/generate-passport-qr.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.94.0"
  }
}
